@prefix rdf: 	<http://www.w3.org/1999/02/22-rdf-syntax-ns#> . 
@prefix rdfs: 	<http://www.w3.org/2000/01/rdf-schema#> . 
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: 	<http://www.w3.org/2001/XMLSchema#> .
@prefix chio: 	<https://dlr-ve-esy.github.io/charging-ontology/> . 
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix bfo: 	<http://purl.obolibrary.org/obo/> . 
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix schema-org: <https://schema.org/> .
@prefix vkg: 	<https://gitlab.dlr.de/vkg#> . 
@prefix vkg-evse: 	<https://gitlab.dlr.de/vkg-evse#> . 
@prefix vkg-common: 	<https://gitlab.dlr.de/vkg-common#> . 

vkg-evse:EVSE[ ottr:IRI ?evse, ?facility, ?ID, ? ?altID ] :: {
  vkg-common:Type(?evse, chio:CHIO_00000016),
  vkg-common:Type(_:column, chio:CHIO_00000005)
  vkg-common:PartOf(_:column, ?facility),
  vkg-common:PartOf(?evse, _:column),
  vkg-common:Identifier(_:identifier, ?ID),
  vkg-common:Identifier(_:identifierAlt, ?altID),
  vkg-common:DesignatedBy(?evse, _:identifier ), 
  vkg-common:DesignatedBy(?evse, _:identifierAlt ), 
} .

vkg-evse:Facility[ ottr:IRI ?facility, ? ottr:IRI ?operator, ? ottr:IRI ?geolocation, ? xsd:string ?ID] :: {
  vkg-common:Type(?facility, chio:CHIO_00000004),
  vkg-common:Identifier(_:identifier, ?ID),
  ottr:Triple(?facility, cco:ont00001879, _:identifier ),
  vkg-common:LocatedIn(?facility, ?geolocation),
  ottr:Triple(?operator, chio:CHIO_00000090, ?facility),
} .

vkg-evse:GeoLocation[ ottr:IRI ?geolocation, ? geo:WktLiteral ?centroid, ? xsd:string ?address, ? xsd:string ?postal_name, ? xsd:string ?state, ? xsd:string ?country, ? xsd:string ?postal_code] :: {
  vkg-common:AddressLocation(_:address, ?address),
  vkg-common:AssignPostCode(?geolocation, ?postal_code),
  vkg-common:LocatedIn(?geolocation, _:address),
  vkg-common:LocalADM(_:local, ?postal_name),
  vkg-common:LocatedIn(_:address, _:local),
  vkg-common:FirstOrderADM(_:state, ?state),
  vkg-common:LocatedIn(_:local, _:state),
  vkg-common:Country(_:country, ?country, ?country),
  vkg-common:LocatedIn(_:state, _:country),
  vkg-common:hasCentroid(?geolocation, ?centroid)
} .

vkg-evse:Operator[ ottr:IRI ?operator, ? xsd:string ?label, ? xsd:string ?ID, ? ottr:IRI ?role ] :: {
  vkg-common:Type(?operator, cco:ont00001180),
  ottr:Triple(?operator, rdfs:label, ?label),
  vkg-common:Identifier(_:label, ?label),
  vkg-common:DesignatedBy(?operator, _:label ), 
  vkg-common:Identifier(_:identifier, ?ID),
  vkg-common:DesignatedBy(?operator, _:identifier ), 
  vkg-common:Type(_:role, ?role),
  vkg-common:BearerOf(?operator, _:role),
} .

vkg-evse:MaxVoltage[ ottr:IRI ?object, ottr:IRI ?ice, xsd:decimal ?voltage ] :: {
  vkg-common:Type(?ice, chio:CHIO_00000091),
  ottr:Triple(?ice, chio:CHIO_00000106, ?voltage),
  ottr:Triple(?object, chio:CHIO_00000110, ?ice)
} .

vkg-evse:MaxAmperage[ ottr:IRI ?object, ottr:IRI ?ice, xsd:decimal ?amperage ] :: {
  vkg-common:Type(?ice, chio:CHIO_00000093),
  ottr:Triple(?ice, chio:CHIO_00000106, ?amperage),
  ottr:Triple(?object, chio:CHIO_00000111, ?ice)
} .

vkg-evse:MaxPower[ ottr:IRI ?object, ottr:IRI ?ice, xsd:decimal ?power ] :: {
  vkg-common:Type(?ice, chio:CHIO_00000092),
  ottr:Triple(?ice, chio:CHIO_00000106, ?power),
  ottr:Triple(?object, chio:CHIO_00000112, ?ice)
} .

vkg-evse:Connection[ ottr:IRI ?evse, ottr:IRI ?pattern, ottr:IRI ?coupling, ? xsd:decimal ?max_voltage, ? xsd:decimal ?max_amperage, ? xsd:decimal ?max_power] :: {
  vkg-common:Type(_:connector, ?coupling),
  vkg-common:PartOf(_:connector, ?evse),
  vkg-common:Type(_:pattern, ?pattern)
  vkg-common:BearerOf(_:connector, _:pattern),
  vkg-evse:MaxVoltage(_:connector, _:max_voltage, ?max_voltage),
  vkg-evse:MaxAmperage(_:connector, _:max_amperage, ?max_amperage),
  vkg-evse:MaxPower(_:connector, _:max_power, ?max_power),
} .
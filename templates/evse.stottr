@prefix rdf: 	<http://www.w3.org/1999/02/22-rdf-syntax-ns#> . 
@prefix rdfs: 	<http://www.w3.org/2000/01/rdf-schema#> . 
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: 	<http://www.w3.org/2001/XMLSchema#> .
@prefix dbo: <https://dbpedia.org/ontology/> .
@prefix chio: 	<https://dlr-ve-esy.github.io/charging_ontology/> . 
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix bfo: 	<http://purl.obolibrary.org/obo/> . 
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix schema-org: <https://schema.org/> .
@prefix vkg: 	<https://gitlab.dlr.de/vkg#> . 
@prefix vkg-evse: 	<https://gitlab.dlr.de/vkg-evse#> . 
@prefix vkg-common: 	<https://gitlab.dlr.de/vkg-common#> . 

vkg-evse:EVSE[ ottr:IRI ?evse, ?facility, ?ID, ? ?altID ] :: {
  vkg-common:Type(?evse, chio:CHIO_00000016),
  ottr:Triple(?evse, bfo:BFO_0000176, ?facility ),
  vkg-common:Identifier(_:identifier, ?ID),
  vkg-common:Identifier(_:identifierAlt, ?altID),
  vkg-common:DesignatedBy(?evse, _:identifier ), 
  vkg-common:DesignatedBy(?evse, _:identifierAlt ), 
} .

vkg-evse:Facility[ ottr:IRI ?facility, ? ottr:IRI ?operator, ? ottr:IRI ?geolocation, ? xsd:string ?ID] :: {
  vkg-common:Type(?facility, chio:CHIO_00000004),
  vkg-common:Identifier(_:identifier, ?ID),
  ottr:Triple(?facility, cco:ont00001879, _:identifier ),
  vkg-common:LocatedIn(?facility, ?geolocation),
  ottr:Triple(?operator, chio:CHIO_00000090, ?facility),
} .

vkg-evse:GeoLocation[ ottr:IRI ?geolocation, ? geo:WktLiteral ?centroid, ? xsd:string ?street, ? xsd:string ?postal_name, ? xsd:string ?state, ? xsd:string ?country] :: {
  vkg-common:Location(_:street, ?street),
  vkg-common:LocatedIn(?geolocation, _:street),
  vkg-common:Location(_:city, ?postal_name),
  vkg-common:LocatedIn(_:street, _:city),
  vkg-common:Location(_:state, ?state),
  vkg-common:LocatedIn(_:city, _:state),
  vkg-common:Location(_:country, ?country),
  vkg-common:LocatedIn(_:state, _:country),
  ottr:Triple(_:country, dbo:iso31661Code, ?country),
  vkg-common:hasCentroid(?geolocation, ?centroid)
} .

vkg-evse:Operator[ ottr:IRI ?operator, ? xsd:string ?label, ? xsd:string ?ID, ? ottr:IRI ?role ] :: {
  vkg-common:Type(?operator, cco:ont00001180),
  ottr:Triple(?operator, rdfs:label, ?label),
  vkg-common:Identifier(_:label, ?label),
  vkg-common:DesignatedBy(?operator, _:label ), 
  vkg-common:Identifier(_:identifier, ?ID),
  vkg-common:DesignatedBy(?operator, _:identifier ), 
  vkg-common:BearerOf(?operator, ?role),
} .

vkg-evse:Connection[ ottr:IRI ?evse, ottr:IRI ?pattern, ottr:IRI ?coupling, ? xsd:decimal ?max_voltage, ? xsd:decimal ?max_amperage, ? xsd:decimal ?max_power] :: {

} .
@prefix rdf: 	<http://www.w3.org/1999/02/22-rdf-syntax-ns#> . 
@prefix rdfs: 	<http://www.w3.org/2000/01/rdf-schema#> . 
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: 	<http://www.w3.org/2001/XMLSchema#> . 
@prefix chio: 	<https://dlr-ve-esy.github.io/charging_ontology/> . 
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix bfo: 	<http://purl.obolibrary.org/obo/> . 
@prefix schema-org: <https://schema.org/> .
@prefix vkg: 	<https://gitlab.dlr.de/vkg#> . 
@prefix vkg-evse: 	<https://gitlab.dlr.de/vkg-evse#> . 
@prefix vkg-common: 	<https://gitlab.dlr.de/vkg-common#> . 

vkg-evse:EVSE[ ottr:IRI ?evse, ?facility, ?ID, ? ?altID ] :: {
  vkg-common:Type(?evse, chio:CHIO_00000016),
  ottr:Triple(?evse, bfo:BFO_0000176, ?facility ),
  vkg-common:Identifier(_:identifier, ?ID),
  vkg-common:Identifier(_:identifierAlt, ?altID),
  vkg-common:DesignatedBy(?evse, _:identifier ), 
  vkg-common:DesignatedBy(?evse, _:identifierAlt ), 
} .

vkg-evse:Facility[ ottr:IRI ?facility, ? ottr:IRI ?operator, ? ottr:IRI ?address, ? ottr:IRI ?spatial, xsd:string ?ID] :: {
  vkg-common:Type(?facility, chio:CHIO_00000004),
  vkg-common:Identifier(_:identifier, ?ID),
  ottr:Triple(?facility, cco:ont00001879, _:identifier ),
  vkg-common:Location( _:location, ?address, ?spatial),
  ottr:Triple(?facility, bfo:BFO_0000171, _:location),
} .

vkg-evse:Address[ ottr:IRI ?address, ? xsd:string ?street, ? xsd:string ?locator_designator, ? xsd:string ?supplement, ? xsd:string ?postal_name, ? xsd:string ?state, ? xsd:string ?country] :: {

} .
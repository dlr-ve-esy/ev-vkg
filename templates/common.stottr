@prefix rdf: 	<http://www.w3.org/1999/02/22-rdf-syntax-ns#> . 
@prefix rdfs: 	<http://www.w3.org/2000/01/rdf-schema#> . 
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: 	<http://www.w3.org/2001/XMLSchema#> . 
@prefix chio: 	<https://dlr-ve-esy.github.io/charging_ontology/> . 
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix bfo: 	<http://purl.obolibrary.org/obo/> . 
@prefix vkg-common: 	<https://gitlab.dlr.de/vkg-common#> . 

vkg-common:Identifier[ ottr:IRI ?id, ?label] :: {
  ottr:Triple(?id, rdf:type, cco:ont00000077),
  ottr:Triple(?id, rdf:value, ?label),
} .

vkg-common:Type[ ottr:IRI ?id, ottr:IRI ?type] :: {
    ottr:Triple(?id, rdf:type, ?type),
} .

vkg-common:DesignatedBy[ ottr:IRI ?designated, ottr:IRI ?designator] :: {
    ottr:Triple(?designated, cco:ont00001879, ?designator ),
} .

vkg-common:Location[ ottr:IRI ?id, ? ottr:IRI ?address, ? ottr:IRI ?spatial] :: {
    vkg-common:Type(?id, cco:ont00000487),
    vkg-common:DesignatedBy(?id, ?address),
    vkg-common:DesignatedBy(?id, ?spatial),
} .
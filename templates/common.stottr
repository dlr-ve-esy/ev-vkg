@prefix rdf: 	<http://www.w3.org/1999/02/22-rdf-syntax-ns#> . 
@prefix rdfs: 	<http://www.w3.org/2000/01/rdf-schema#> . 
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: 	<http://www.w3.org/2001/XMLSchema#> . 
@prefix chio: 	<https://dlr-ve-esy.github.io/charging_ontology/> . 
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix bfo: 	<http://purl.obolibrary.org/obo/> . 
@prefix vkg-common: 	<https://gitlab.dlr.de/vkg-common#> . 
@prefix geo: <http://www.opengis.net/ont/geosparql#> .

vkg-common:Identifier[ ottr:IRI ?id, ?label] :: {
  ottr:Triple(?id, rdf:type, cco:ont00000077),
  ottr:Triple(?id, rdf:value, ?label),
} .

vkg-common:Type[ ottr:IRI ?id, ottr:IRI ?type] :: {
    ottr:Triple(?id, rdf:type, ?type),
} .

vkg-common:DesignatedBy[ ottr:IRI ?designated, ottr:IRI ?designator] :: {
    ottr:Triple(?designated, cco:ont00001879, ?designator ),
} .

vkg-common:Location[ ottr:IRI ?location, ? xsd:string ?label] :: {
    vkg-common:Type(?location, cco:ont00000487),
    vkg-common:Identifier(_:identifier, ?label),
    vkg-common:DesignatedBy(?location, _:identifier)
} .

vkg-common:LocatedIn[ ottr:IRI ?inner, ottr:IRI ?outer ] :: {
    ottr:Triple(?inner, bfo:BFO_0000171, ?outer),
} .

vkg-common:PartOf[ ottr:IRI ?left, ottr:IRI ?right ] :: {
    ottr:Triple(?left, bfo:BFO_0000176, ?right),
} .

vkg-common:hasCentroid[ottr:IRI ?geolocation, geo:WktLiteral ?centroid ] :: {
    ottr:Triple(?geolocation, geo:hasCentroid, _:centroid)
    ottr:Triple(_:centroid, geo:asWKT, ?centroid)
} .

vkg-common:BearerOf[ottr:IRI ?bearer, ottr:IRI ?attribute]  :: {
    ottr:Triple(?bearer, bfo:BFO_0000196, ?attribute)
} .